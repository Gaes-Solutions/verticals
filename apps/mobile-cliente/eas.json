{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "corepack": true,
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "corepack": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.angaes.com/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "corepack": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.angaes.com/api"
      }
    },
    "gaesland-staging": {
      "extends": "preview",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://verticals-staging.up.railway.app",
        "EXPO_PUBLIC_TIENDA": "gaesland",
        "EXPO_PUBLIC_APP_VARIANT": "staging"
      }
    },
    "gaesland-staging-phone": {
      "extends": "gaesland-staging",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a,armeabi-v7a"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
