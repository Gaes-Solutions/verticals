# Copia a .env.staging y rellena todos los valores. Nunca subas .env.staging.
# Staging debe usar una base de datos, Redis, dominios y credenciales distintos.
GITHUB_REPOSITORY=gaes-solutions/gaespos
API_TAG=staging
TIENDA_TAG=staging
ADMIN_TAG=staging
POS_TAG=staging
SUPERADMIN_TAG=staging

POSTGRES_USER=gaespos_staging
POSTGRES_PASSWORD=cambia-por-un-secreto-largo
POSTGRES_DB=gaespos_staging
REDIS_PASSWORD=cambia-por-otro-secreto-largo
JWT_SECRET=cambia-por-un-secreto-de-staging
JWT_REFRESH_SECRET=cambia-por-otro-secreto-de-staging
COOKIE_SECRET=cambia-por-otro-secreto-de-staging
SEED_ADMIN_EMAIL=admin-staging@example.invalid
SEED_ADMIN_PASSWORD=cambia-por-una-clave-de-staging
CORS_ORIGIN=http://localhost:3101
STOREFRONT_APEX=staging.shop.gaessoft.mx
STOREFRONT_CNAME_TARGET=staging-stores.gaessoft.mx
PRODUCTOS_MEDIA_ROOT=/data/productos
KIOSKO_MEDIA_ROOT=/data/kiosko
TIENDA_TENANT_SLUG=gaesland
TIENDA_USER_EMAIL=staging@example.invalid
TIENDA_USER_PASSWORD=cambia-por-una-clave-de-staging
STAGING_API_PORT=3100
STAGING_TIENDA_PORT=3101
STAGING_ADMIN_PORT=5175
STAGING_POS_PORT=5178
STAGING_SUPERADMIN_PORT=5179
