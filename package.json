{
  "name": "gaespos",
  "version": "0.0.0",
  "private": true,
  "description": "GaesSoft POS — SaaS multi-tenant POS para México (Retail, Abarrotes, Salud Vet/Humana)",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:dev": "dotenv -e .env -- turbo test",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepare": "husky",
    "dev:db": "docker compose up -d",
    "dev:db:down": "docker compose down",
    "dev:db:reset": "docker compose down -v",
    "dev:db:logs": "docker compose logs -f",
    "db:generate": "dotenv -e .env -- pnpm --filter @gaespos/db prisma:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @gaespos/db prisma:migrate",
    "db:migrate:deploy": "dotenv -e .env -- pnpm --filter @gaespos/db prisma:migrate:deploy",
    "db:studio": "dotenv -e .env -- pnpm --filter @gaespos/db prisma:studio",
    "db:reset": "dotenv -e .env -- pnpm --filter @gaespos/db prisma:reset",
    "db:seed": "dotenv -e .env -- pnpm --filter @gaespos/db seed:master",
    "gaes-migrate": "dotenv -e .env -- pnpm --filter @gaespos/db migrate",
    "dev:api": "dotenv -e .env -- pnpm --filter @gaespos/api dev",
    "e2e": "playwright test --config tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "dotenv-cli": "^8.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}": ["biome check --write --no-errors-on-unmatched"]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "@types/react": "19.2.15",
      "shell-quote@>=1.8.4 <1.11.0": "1.11.0",
      "fast-uri@3": "3.1.8",
      "fast-jwt@6": "6.3.4",
      "form-data@4": "4.0.6",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "nanoid@3": "3.3.20",
      "browserslist@4": "4.28.7",
      "baseline-browser-mapping@2": "2.11.12",
      "source-map-js@1": "1.2.2",
      "compression@1": "1.8.2",
      "ajv@8": "8.20.0",
      "undici@6": "6.28.1",
      "postcss@8": "8.5.31",
      "@xmldom/xmldom@0.8": "0.8.15",
      "@xmldom/xmldom@0.9": "0.9.12",
      "xcode>uuid": "11.1.1",
      "next@15>sharp": "0.35.5"
    },
    "patchedDependencies": {
      "decode-uri-component@0.2.2": "patches/decode-uri-component@0.2.2.patch",
      "image-size@1.2.1": "patches/image-size@1.2.1.patch"
    }
  }
}
